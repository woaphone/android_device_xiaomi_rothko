# Charge
persist.vendor.accelerate.charge=true

# GPS
persist.sys.gps.enhance.ffae=true
#enable gps low power mode
persist.sys.gps.lowPowerMode=true

# Surface Flinger
debug.sf.high_fps.late.sf.duration=10300000
debug.sf.high_fps.late.app.duration=11600000
debug.sf.high_fps.early.sf.duration=10300000
debug.sf.high_fps.early.app.duration=11600000
debug.sf.high_fps.earlyGl.sf.duration=10300000
debug.sf.high_fps.earlyGl.app.duration=11600000
#VSYNC durations for 144 fps
debug.sf.144_fps.late.sf.duration=8900000
debug.sf.144_fps.late.app.duration=10500000
debug.sf.144_fps.early.sf.duration=8900000
debug.sf.144_fps.early.app.duration=10500000
debug.sf.144_fps.earlyGl.sf.duration=8900000
debug.sf.144_fps.earlyGl.app.duration=10500000
ro.surface_flinger.enable_frame_rate_override=false

# NFC
ro.vendor.se.type=eSE,HCE,UICC
ro.vendor.se.chip.model=SN220T
ro.vendor.nfc.disable.i2c=false
ro.vendor.se.info=19-1010212
ro.vendor.nfc.repair=1
ro.vendor.nfc.dispatch_optim=2
ro.vendor.nfc.secure_display_optim=1
ro.vendor.nfc.selectcard=1
ro.vendor.nfc.aclog=1
ro.vendor.nfc.debounce_field_on=1
ro.vendor.nfc.field_on_debounce=500
ro.vendor.nfc.mibeam=1

